{
  "name": "@zatgo/accounting-desktop",
  "version": "0.1.0",
  "description": "ZatGo accounting desktop client",
  "author": "ZatGo Innovation <team.zatgoinnovation@gmail.com>",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "dist:linux": "pnpm build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "online.zatgo.accounting-desktop",
    "productName": "ZatGo Accounting",
    "executableName": "zatgo-accounting",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": ["dist/**", "dist-electron/**"],
    "directories": { "output": "release" },
    "win": {
      "target": ["portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "@zatgo/auth": "workspace:*",
    "@zatgo/erpnext": "workspace:*",
    "@zatgo/icons": "workspace:*",
    "@zatgo/sdk": "workspace:*",
    "@zatgo/ui": "workspace:*",
    "@zatgo/utils": "workspace:*",
    "framer-motion": "^11.15.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@zatgo/config": "workspace:*",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
